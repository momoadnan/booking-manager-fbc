{
  "name": "fulhadhoo-booking-manager",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "dev": "vite dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build",
    "preview": "wrangler dev",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:local": "wrangler d1 migrations apply booking-manager --local",
    "db:remote": "wrangler d1 migrations apply booking-manager --remote",
    "deploy": "npm run check && npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.0.0"
  }
}
